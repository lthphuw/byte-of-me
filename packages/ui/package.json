{
  "name": "@byte-of-me/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Facade that re-exports the TipTap-free UI packages for byte-of-me apps.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "sideEffects": false,
  "dependencies": {
    "@byte-of-me/ui-carousel": "workspace:*",
    "@byte-of-me/ui-forms": "workspace:*",
    "@byte-of-me/ui-hooks": "workspace:*",
    "@byte-of-me/ui-motion": "workspace:*",
    "@byte-of-me/ui-primitives": "workspace:*",
    "@byte-of-me/ui-toast": "workspace:*"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
