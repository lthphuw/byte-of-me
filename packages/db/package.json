{
  "name": "@byte-of-me/db",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "bun test",
    "generate": "prisma generate",
    "clean": "rm -rf dist",
    "build": "bun run clean && prisma generate && bun build ./src/index.ts --outdir dist --target node --format esm && bun run types",
    "types": "tsc --skipLibCheck --declaration --emitDeclarationOnly --esModuleInterop --declarationDir dist --rootDir src",
    "prepublishOnly": "cd ../../ && turbo run build",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@prisma/client-runtime-utils": "^7.5.0",
    "@types/node": "^25.5.0",
    "dotenv": "^16.6.0",
    "eslint": "^9.30.0",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@byte-of-me/logger": "workspace:*",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.7.0"
  }
}
