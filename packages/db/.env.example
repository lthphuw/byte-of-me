# Copy to packages/db/.env. Points at the local compose stack (docs/setup.md).
# Production: use your own connection strings here, never commit them.

# Migrations and seed read DATABASE_URL (prisma.config.ts). DIRECT_URL must be set too.
DATABASE_URL=postgresql://admin:secret@localhost:5432/byte_of_me
DIRECT_URL=postgresql://admin:secret@localhost:5432/byte_of_me
NODE_ENV=development

# Email of the seeded admin. Must equal EMAIL in apps/web/.env: that is the address you sign in with.
EMAIL=you@example.com
