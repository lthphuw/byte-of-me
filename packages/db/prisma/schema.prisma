generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ===============================
// AUTHENTICATION (Authjs)
// ===============================
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===============================
// USER
// ===============================

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role String @default("USER")

  // NextAuth
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")

  accounts Account[]
  sessions Session[]

  // Relations
  userProfile       UserProfile?
  socialLinks       SocialLink[]
  blogs             Blog[]
  educations        Education[]
  workExperiences   Company[]
  projects          Project[]
  techStacks        TechStack[]
  media             Media[]
  interactions      Interaction[]
  comments          Comment[]
  contactMessages   ContactMessage[]
  blogStatisticLogs BlogStatisticLog[]
  notes             Note[]
  noteLabels        NoteLabel[]

  @@map("users")
}

model SocialLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  platform  String
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  // mediaId String? @map("media_id")
  // image   Media?  @relation(fields: [mediaId], references: [id])

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
  @@map("social_links")
}

model UserProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  birthdate DateTime? @map("birthdate")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  translations UserProfileTranslation[]

  @@map("user_profiles")
}

model UserProfileTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  displayName String? @map("display_name")
  firstName   String? @map("first_name")
  middleName  String? @map("middle_name")
  lastName    String? @map("last_name")
  greeting    String? @db.Text
  tagLine     String? @map("tag_line") @db.Text
  quote       String? @db.Text
  quoteAuthor String? @map("quote_author")
  bio         String? @db.Text
  aboutMe     String? @map("about_me") @db.Text

  userProfileId String      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, language])
  @@map("user_profile_translations")
}

// ===============================
// EDUCATION
// ===============================

model Education {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sortOrder Int       @default(0)
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  // SetNull, not Cascade: deleting a Media row must clear the logo, never
  // destroy the education entry that referenced it.
  logoId String? @map("logo_id")
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievements EducationAchievement[]
  translations EducationTranslation[]

  @@index([userId], map: "idx_educations_user_id")
  @@index([logoId], map: "idx_educations_logo_id")
  @@map("educations")
}

model EducationTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text

  educationId     String    @map("education_id")
  educationSchema Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, language])
  @@map("education_translations")
}

model EducationAchievement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sortOrder Int @default(0) @map("sort_order")

  educationId     String    @map("education_id")
  educationSchema Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  translations EducationAchievementTranslation[]
  images       AchievementOnMedias[]

  @@index([educationId], map: "idx_education_achievement_education_id")
  @@map("education_achievements")
}

model EducationAchievementTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title   String
  content String? @db.Text

  educationAchievementId String               @map("education_achievement_id")
  educationAchievement   EducationAchievement @relation(fields: [educationAchievementId], references: [id], onDelete: Cascade)

  @@unique([educationAchievementId, language])
  @@map("education_achievement_translations")
}

model AchievementOnMedias {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mediaId String @map("media_id")
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  educationAchievementId String               @map("education_achievement_id")
  educationAchievement   EducationAchievement @relation(fields: [educationAchievementId], references: [id], onDelete: Cascade)

  @@id([educationAchievementId, mediaId])
  @@index([mediaId], map: "idx_achievement_medias")
  @@map("achievement_medias")
}

// ===============================
// TECH STACKS
// ===============================

model TechStack {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name      String @unique
  slug      String @unique
  group     String
  sortOrder Int    @default(0) @map("sort_order")

  logoId String? @map("logo_id")
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects  TechStackOnProjects[]
  companies TechStackOnCompanies[]

  @@index([userId], map: "idx_tech_stacks_user_id")
  @@index([logoId], map: "idx_tech_stacks_logo_id")
  @@map("tech_stacks")
}

model TechStackOnProjects {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  techStackId String    @map("tech_stack_id")
  techStack   TechStack @relation(fields: [techStackId], references: [id], onDelete: Cascade)

  @@id([projectId, techStackId])
  @@index([techStackId], map: "idx_project_tech_stacks_tech_stack_id")
  @@map("project_tech_stacks")
}

model TechStackOnCompanies {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  techStackId String    @map("tech_stack_id")
  techStack   TechStack @relation(fields: [techStackId], references: [id], onDelete: Cascade)

  @@id([techStackId, companyId])
  @@map("company_tech_stacks")
}

// ===============================
// WORK EXPERIENCE
// ===============================

model Company {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  String
  location String

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  logoId String? @map("logo_id")
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles      Role[]
  techStacks TechStackOnCompanies[]

  translations CompanyTranslation[]

  @@index([userId], map: "idx_companies_user_id")
  @@index([logoId], map: "idx_companies_logo_id")
  @@map("companies")
}

model CompanyTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  description String? @db.Text

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, language])
  @@map("company_translations")
}

model Role {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tasks        Task[]
  translations RoleTranslation[]

  @@index([companyId], map: "idx_roles_company_id")
  @@map("roles")
}

model RoleTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, language], map: "uidx_role_translation_role_id_language")
  @@map("role_translations")
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sortOrder Int      @default(0) @map("sort_order")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  translations TaskTranslation[]

  @@index([roleId], map: "idx_tasks_role_id")
  @@map("tasks")
}

model TaskTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  content String @db.Text

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, language])
  @@map("task_translations")
}

// ===============================
// PROJECTS & BLOGS
// ===============================

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slug        String    @unique
  githubLink  String?   @map("github_link")
  liveLink    String?   @map("live_link")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isPublished Boolean   @default(false) @map("is_published")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  translations ProjectTranslation[]
  techStacks   TechStackOnProjects[]
  tags         ProjectTag[]

  blog Blog?

  coauthors    ProjectOnProjectCoAuthor[]
  interactions Interaction[]
  comments     Comment[]

  @@index([userId, isPublished, startDate], map: "idx_projects_public_list")
  @@map("projects")
}

model ProjectTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, language])
  @@map("project_translations")
}

model ProjectOnProjectCoAuthor {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  coauthorId String   @map("coauthor_id")
  coauthor   Coauthor @relation(fields: [coauthorId], references: [id], onDelete: Cascade)

  @@id([projectId, coauthorId])
  @@index([coauthorId], map: "idx_project_coauthor_coauthor_id")
  @@map("project_coauthors")
}

model Coauthor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fullName String  @map("full_name")
  email    String?

  projects ProjectOnProjectCoAuthor[]

  @@map("coauthors")
}

model Blog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slug          String    @unique
  publishedDate DateTime? @default(now()) @map("published_date")
  isPublished   Boolean   @default(false) @map("is_published")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?  @unique @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  readingTime Int? @map("reading_time")

  coverImageId String? @map("cover_image_id")
  coverImage   Media?  @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  translations BlogTranslation[]
  tags         BlogTag[]
  interactions Interaction[]
  comments     Comment[]
  blogViewLogs BlogStatisticLog[]

  @@index([userId], map: "idx_blogs_user_id")
  @@index([isPublished, publishedDate(sort: Desc)], map: "idx_blogs_published_feed")
  @@index([coverImageId], map: "idx_blogs_cover_image_id")
  @@map("blogs")
}

model BlogTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text
  content     String  @db.Text

  blogId String @map("blog_id")
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, language])
  @@map("blog_translations")
}

model BlogStatisticLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  blogId String @map("blog_id")
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  readingTime Int? @map("reading_time") // in seconds

  isAnonymous Boolean @default(true) @map("is_anonymous")
  viewerId    String? @map("viewer_id")
  viewer      User?   @relation(fields: [viewerId], references: [id])

  referrer   String? @db.Text
  deviceType String? @map("device_type") // e.g., "mobile", "desktop", "tablet"
  browser    String? // e.g., "Chrome", "Safari"

  countryCode String? @map("country_code") // e.g., "US", "VN", "GB"

  @@index([blogId], map: "idx_blog_view_logs_blog_id")
  @@index([blogId, createdAt(sort: Desc)], map: "idx_blog_logs_time_series")
  @@index([blogId, deviceType], map: "idx_blog_logs_device")
  @@index([blogId, countryCode], map: "idx_blog_logs_country")
  @@index([viewerId], map: "idx_blog_view_logs_viewer_id")
  @@map("blog_view_logs")
}

// ===============================
// TAGS
// ===============================

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slug         String           @unique
  translations TagTranslation[]
  blogs        BlogTag[]
  projects     ProjectTag[]

  @@map("tags")
}

model TagTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  // Not globally unique: the same display name legitimately repeats across
  // locales of one tag ("React" in en and vi) — @@unique([tagId, language])
  // below is the real constraint.
  name String

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, language])
  @@map("tag_translations")
}

model BlogTag {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blogId String @map("blog_id")
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId], map: "idx_blog_tags_tag_id")
  @@map("blog_tags")
}

model ProjectTag {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId], map: "idx_project_tag_tag_id")
  @@map("project_tags")
}

// ===============================
// MEDIA
// ===============================

model Media {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fileName String @map("file_name")
  fileKey  String @unique @map("file_key")
  mimeType String @map("mime_type")
  size     Int
  provider String
  bucket   String
  url      String

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // socialLinks         SocialLink[]
  companies           Company[]
  techStacks          TechStack[]
  educationSchema     Education[]
  educationAchiements AchievementOnMedias[]
  blogs               Blog[]

  @@index([userId], map: "idx_media_user_id")
  @@map("media")
}

// ===============================
// INTERACTION (Likes, Shares, etc.)
// ===============================

model Interaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Loại tương tác (VD: "LIKE", "HEART", "CLAP", "SHARE")
  type String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  blogId String? @map("blog_id")
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId, type], map: "uq_user_blog_interaction")
  @@unique([userId, projectId, type], map: "uq_user_project_interaction")
  @@index([blogId, type], map: "idx_interactions_blog_type")
  @@index([projectId], map: "idx_interactions_project_id")
  @@map("interactions")
}

// ===============================
// COMMENTS
// ===============================
model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  content   String  @db.Text
  isDeleted Boolean @default(false) @map("is_deleted")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Comment có thể thuộc về Blog hoặc Project
  blogId String? @map("blog_id")
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Hỗ trợ Nested Comments (Trả lời comment)
  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentToComment")

  @@index([blogId, parentId, isDeleted], map: "idx_comments_blog_thread")
  @@index([projectId], map: "idx_comments_project_id")
  @@index([parentId], map: "idx_comments_parent_id")
  @@map("comments")
}

// ===============================
// RATE LIMITING
// ===============================

// Fixed-window counters for anonymous/public write endpoints (contact form,
// comments, view tracking). One row per (key, window); expired windows are
// cleaned up opportunistically by the limiter itself.
model RateLimitHit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@id([key, windowStart])
  @@map("rate_limit_hits")
}

// ===============================
// CONTACT
// ===============================
model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  name    String
  email   String
  subject String?
  message String  @db.Text

  isRead    Boolean @default(false) @map("is_read")
  isReplied Boolean @default(false) @map("is_replied")

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([email], map: "idx_contact_email")
  @@index([userId, createdAt], map: "idx_contact_user_created")
  @@map("contact_messages")
}

// ===============================
// PRIVATE NOTES
// ===============================

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())  @map("created_at")
  updatedAt DateTime @updatedAt       @map("updated_at")

  title     String
  content   String  @db.Text                     // stringified Tiptap JSON
  plainText String  @db.Text @map("plain_text")  // derived from content, never client-supplied

  /// Free-form workflow state ("draft", "active", "done", …) — groupable in the
  /// explorer; the trash mechanism stays `archivedAt`, not a status value.
  status String @default("draft")

  /// Free-form key→scalar map (the note's "frontmatter"). Serialized to real
  /// YAML only at .md export time; queries and grouped views read columns.
  properties Json?

  /// Generated in SQL from title + plain_text; Prisma never writes it.
  /// `simple` config on purpose: the corpus is mixed EN/VI and language
  /// stemming would lie — measured, `đây` stems to `đâi` and `máy` to `mái`.
  /// TWO vectors concatenated since widen_note_search_vector: the text as
  /// written, plus the same text with joining punctuation turned into spaces,
  /// so `apps/web/src` is findable both whole and as its parts. See that
  /// migration for the numbers.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// A pure container in the same tree (Obsidian-style folder): no document
  /// of its own, excluded from search/flat/grouped views, expand-on-click.
  isFolder Boolean @default(false) @map("is_folder")

  isPinned   Boolean   @default(false) @map("is_pinned")
  archivedAt DateTime?                 @map("archived_at")

  parentId String? @map("parent_id")
  parent   Note?   @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Note[]  @relation("NoteTree")
  position Int     @default(0)

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  outgoingLinks NoteLink[]    @relation("NoteLinkSource")
  incomingLinks NoteLink[]    @relation("NoteLinkTarget")
  labels        NoteOnLabel[]

  @@index([ownerId, parentId, position], map: "idx_notes_owner_id_parent_id_position")
  @@index([ownerId, updatedAt(sort: Desc)], map: "idx_notes_owner_id_updated_at")
  @@map("notes")
}

model NoteLink {
  createdAt DateTime @default(now()) @map("created_at")

  sourceId String @map("source_id")
  source   Note   @relation("NoteLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId String @map("target_id")
  target   Note   @relation("NoteLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
  @@index([targetId], map: "idx_note_links_target_id")
  @@map("note_links")
}

model NoteLabel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  name  String
  color String?

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  notes NoteOnLabel[]

  @@unique([ownerId, name])
  @@map("note_labels")
}

model NoteOnLabel {
  createdAt DateTime @default(now()) @map("created_at")

  noteId String @map("note_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  labelId   String    @map("label_id")
  label     NoteLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([noteId, labelId])
  @@index([labelId], map: "idx_note_on_labels_label_id")
  @@map("note_on_labels")
}
