generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  importFileExtension    = "ts"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ===============================
// AUTHENTICATION (Authjs)
// ===============================
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===============================
// USER
// ===============================

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role String @default("USER")

  // NextAuth
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")

  accounts Account[]
  sessions Session[]

  // Relations
  userProfile       UserProfile?
  socialLinks       SocialLink[]
  blogs             Blog[]
  educations        Education[]
  workExperiences   Company[]
  projects          Project[]
  techStacks        TechStack[]
  media             Media[]
  interactions      Interaction[]
  comments          Comment[]
  contactMessages   ContactMessage[]
  blogStatisticLogs BlogStatisticLog[]
  notes             Note[]
  noteLabels        NoteLabel[]
  noteDocuments     NoteDocument[]
  workspaceSettings WorkspaceSettings?
  sleepLogs         SleepLog[]
  exercises         Exercise[]
  routines          Routine[]
  workoutSessions   WorkoutSession[]
  dayEntries        DayEntry[]
  dayPhotos         DayPhoto[]

  noteSharesReceived NoteShare[] @relation("NoteShareRecipient")
  noteSharesSent     NoteShare[] @relation("NoteShareInviter")

  @@map("users")
}

model SocialLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  platform  String
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  // mediaId String? @map("media_id")
  // image   Media?  @relation(fields: [mediaId], references: [id])

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, platform])
  @@map("social_links")
}

model UserProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  birthdate DateTime? @map("birthdate")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  translations UserProfileTranslation[]

  @@map("user_profiles")
}

model UserProfileTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  displayName String? @map("display_name")
  firstName   String? @map("first_name")
  middleName  String? @map("middle_name")
  lastName    String? @map("last_name")
  greeting    String? @db.Text
  tagLine     String? @map("tag_line") @db.Text
  quote       String? @db.Text
  quoteAuthor String? @map("quote_author")
  bio         String? @db.Text
  aboutMe     String? @map("about_me") @db.Text

  userProfileId String      @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, language])
  @@map("user_profile_translations")
}

// ===============================
// EDUCATION
// ===============================

model Education {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sortOrder Int       @default(0)
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  // SetNull, not Cascade: deleting a Media row must clear the logo, never
  // destroy the education entry that referenced it.
  logoId String? @map("logo_id")
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievements EducationAchievement[]
  translations EducationTranslation[]

  @@index([userId], map: "idx_educations_user_id")
  @@index([logoId], map: "idx_educations_logo_id")
  @@map("educations")
}

model EducationTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text

  educationId     String    @map("education_id")
  educationSchema Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, language])
  @@map("education_translations")
}

model EducationAchievement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sortOrder Int @default(0) @map("sort_order")

  educationId     String    @map("education_id")
  educationSchema Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  translations EducationAchievementTranslation[]
  images       AchievementOnMedias[]

  @@index([educationId], map: "idx_education_achievement_education_id")
  @@map("education_achievements")
}

model EducationAchievementTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title   String
  content String? @db.Text

  educationAchievementId String               @map("education_achievement_id")
  educationAchievement   EducationAchievement @relation(fields: [educationAchievementId], references: [id], onDelete: Cascade)

  @@unique([educationAchievementId, language])
  @@map("education_achievement_translations")
}

model AchievementOnMedias {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mediaId String @map("media_id")
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  educationAchievementId String               @map("education_achievement_id")
  educationAchievement   EducationAchievement @relation(fields: [educationAchievementId], references: [id], onDelete: Cascade)

  @@id([educationAchievementId, mediaId])
  @@index([mediaId], map: "idx_achievement_medias")
  @@map("achievement_medias")
}

// ===============================
// TECH STACKS
// ===============================

model TechStack {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name      String @unique
  slug      String @unique
  group     String
  sortOrder Int    @default(0) @map("sort_order")

  logoId String? @map("logo_id")
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects  TechStackOnProjects[]
  companies TechStackOnCompanies[]

  @@index([userId], map: "idx_tech_stacks_user_id")
  @@index([logoId], map: "idx_tech_stacks_logo_id")
  @@map("tech_stacks")
}

model TechStackOnProjects {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  techStackId String    @map("tech_stack_id")
  techStack   TechStack @relation(fields: [techStackId], references: [id], onDelete: Cascade)

  @@id([projectId, techStackId])
  @@index([techStackId], map: "idx_project_tech_stacks_tech_stack_id")
  @@map("project_tech_stacks")
}

model TechStackOnCompanies {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  techStackId String    @map("tech_stack_id")
  techStack   TechStack @relation(fields: [techStackId], references: [id], onDelete: Cascade)

  @@id([techStackId, companyId])
  @@map("company_tech_stacks")
}

// ===============================
// WORK EXPERIENCE
// ===============================

model Company {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  String
  location String

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  logoId String? @map("logo_id")
  logo   Media?  @relation(fields: [logoId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles      Role[]
  techStacks TechStackOnCompanies[]

  translations CompanyTranslation[]

  @@index([userId], map: "idx_companies_user_id")
  @@index([logoId], map: "idx_companies_logo_id")
  @@map("companies")
}

model CompanyTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  description String? @db.Text

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, language])
  @@map("company_translations")
}

model Role {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tasks        Task[]
  translations RoleTranslation[]

  @@index([companyId], map: "idx_roles_company_id")
  @@map("roles")
}

model RoleTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, language], map: "uidx_role_translation_role_id_language")
  @@map("role_translations")
}

model Task {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sortOrder Int      @default(0) @map("sort_order")

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  translations TaskTranslation[]

  @@index([roleId], map: "idx_tasks_role_id")
  @@map("tasks")
}

model TaskTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  content String @db.Text

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, language])
  @@map("task_translations")
}

// ===============================
// PROJECTS & BLOGS
// ===============================

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slug        String    @unique
  githubLink  String?   @map("github_link")
  liveLink    String?   @map("live_link")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isPublished Boolean   @default(false) @map("is_published")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  translations ProjectTranslation[]
  techStacks   TechStackOnProjects[]
  tags         ProjectTag[]

  blog Blog?

  coauthors    ProjectOnProjectCoAuthor[]
  interactions Interaction[]
  comments     Comment[]

  @@index([userId, isPublished, startDate], map: "idx_projects_public_list")
  // The admin list is by owner, newest first — the public index above leads
  // with `is_published` and cannot serve it.
  @@index([userId, createdAt(sort: Desc)], map: "idx_projects_user_created_at")
  @@map("projects")
}

model ProjectTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, language])
  @@map("project_translations")
}

model ProjectOnProjectCoAuthor {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  coauthorId String   @map("coauthor_id")
  coauthor   Coauthor @relation(fields: [coauthorId], references: [id], onDelete: Cascade)

  @@id([projectId, coauthorId])
  @@index([coauthorId], map: "idx_project_coauthor_coauthor_id")
  @@map("project_coauthors")
}

model Coauthor {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fullName String  @map("full_name")
  email    String?

  projects ProjectOnProjectCoAuthor[]

  @@map("coauthors")
}

model Blog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slug          String    @unique
  publishedDate DateTime? @default(now()) @map("published_date")
  isPublished   Boolean   @default(false) @map("is_published")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?  @unique @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  readingTime Int? @map("reading_time")

  coverImageId String? @map("cover_image_id")
  coverImage   Media?  @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  translations BlogTranslation[]
  tags         BlogTag[]
  interactions Interaction[]
  comments     Comment[]
  blogViewLogs BlogStatisticLog[]

  @@index([userId], map: "idx_blogs_user_id")
  @@index([isPublished, publishedDate(sort: Desc)], map: "idx_blogs_published_feed")
  @@index([coverImageId], map: "idx_blogs_cover_image_id")
  @@map("blogs")
}

model BlogTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  title       String
  description String? @db.Text
  content     String  @db.Text

  blogId String @map("blog_id")
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, language])
  @@map("blog_translations")
}

model BlogStatisticLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  blogId String @map("blog_id")
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  readingTime Int? @map("reading_time") // in seconds

  isAnonymous Boolean @default(true) @map("is_anonymous")
  viewerId    String? @map("viewer_id")
  viewer      User?   @relation(fields: [viewerId], references: [id])

  referrer   String? @db.Text
  deviceType String? @map("device_type") // e.g., "mobile", "desktop", "tablet"
  browser    String? // e.g., "Chrome", "Safari"

  countryCode String? @map("country_code") // e.g., "US", "VN", "GB"

  @@index([blogId], map: "idx_blog_view_logs_blog_id")
  @@index([blogId, createdAt(sort: Desc)], map: "idx_blog_logs_time_series")
  @@index([blogId, deviceType], map: "idx_blog_logs_device")
  @@index([blogId, countryCode], map: "idx_blog_logs_country")
  @@index([viewerId], map: "idx_blog_view_logs_viewer_id")
  // The dashboard's 30-day rollup and all-time count filter/scan on time
  // alone; every index above leads with `blog_id`, so neither could use one.
  @@index([createdAt(sort: Desc)], map: "idx_blog_view_logs_created_at")
  @@map("blog_view_logs")
}

// ===============================
// TAGS
// ===============================

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slug         String           @unique
  translations TagTranslation[]
  blogs        BlogTag[]
  projects     ProjectTag[]

  // The admin list is a single unscoped page ordered by recency.
  @@index([createdAt(sort: Desc)], map: "idx_tags_created_at")
  @@map("tags")
}

model TagTranslation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  language String

  // Not globally unique: the same display name legitimately repeats across
  // locales of one tag ("React" in en and vi) — @@unique([tagId, language])
  // below is the real constraint.
  name String

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, language])
  @@map("tag_translations")
}

model BlogTag {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blogId String @map("blog_id")
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@index([tagId], map: "idx_blog_tags_tag_id")
  @@map("blog_tags")
}

model ProjectTag {
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id")
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId], map: "idx_project_tag_tag_id")
  @@map("project_tags")
}

// ===============================
// MEDIA
// ===============================

model Media {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fileName String @map("file_name")
  fileKey  String @unique @map("file_key")
  mimeType String @map("mime_type")
  size     Int
  provider String
  bucket   String
  url      String

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // socialLinks         SocialLink[]
  companies           Company[]
  techStacks          TechStack[]
  educationSchema     Education[]
  educationAchiements AchievementOnMedias[]
  blogs               Blog[]

  // The library is paged by owner, newest first.
  @@index([userId, createdAt(sort: Desc)], map: "idx_media_user_created_at")
  @@map("media")
}

// ===============================
// INTERACTION (Likes, Shares, etc.)
// ===============================

model Interaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Loại tương tác (VD: "LIKE", "HEART", "CLAP", "SHARE")
  type String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  blogId String? @map("blog_id")
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId, type], map: "uq_user_blog_interaction")
  @@unique([userId, projectId, type], map: "uq_user_project_interaction")
  @@index([blogId, type], map: "idx_interactions_blog_type")
  @@index([projectId], map: "idx_interactions_project_id")
  // `groupBy(['type'])` with no filter, for the analytics like/clap totals.
  @@index([type], map: "idx_interactions_type")
  @@map("interactions")
}

// ===============================
// COMMENTS
// ===============================
model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  content   String  @db.Text
  isDeleted Boolean @default(false) @map("is_deleted")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Comment có thể thuộc về Blog hoặc Project
  blogId String? @map("blog_id")
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Hỗ trợ Nested Comments (Trả lời comment)
  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentToComment")

  @@index([blogId, parentId, isDeleted], map: "idx_comments_blog_thread")
  @@index([projectId], map: "idx_comments_project_id")
  @@index([parentId], map: "idx_comments_parent_id")
  // The moderation list orders by recency across every blog and project.
  @@index([createdAt(sort: Desc)], map: "idx_comments_created_at")
  @@map("comments")
}

// ===============================
// RATE LIMITING
// ===============================

// Fixed-window counters for anonymous/public write endpoints (contact form,
// comments, view tracking). One row per (key, window); expired windows are
// cleaned up opportunistically by the limiter itself.
model RateLimitHit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@id([key, windowStart])
  @@map("rate_limit_hits")
}

// ===============================
// CONTACT
// ===============================
model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  name    String
  email   String
  subject String?
  message String  @db.Text

  isRead    Boolean @default(false) @map("is_read")
  isReplied Boolean @default(false) @map("is_replied")

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([email], map: "idx_contact_email")
  @@index([userId, createdAt], map: "idx_contact_user_created")
  @@map("contact_messages")
}

// ===============================
// PRIVATE NOTES
// ===============================

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title     String
  content   String @db.Text // stringified Tiptap JSON
  plainText String @map("plain_text") @db.Text // derived from content, never client-supplied

  /// Free-form workflow state ("draft", "active", "done", …) — groupable in the
  /// explorer; the trash mechanism stays `archivedAt`, not a status value.
  status String @default("draft")

  /// Free-form key→scalar map (the note's "frontmatter"). Serialized to real
  /// YAML only at .md export time; queries and grouped views read columns.
  properties Json?

  /// Generated in SQL from title + plain_text; Prisma never writes it.
  /// `simple` config on purpose: the corpus is mixed EN/VI and language
  /// stemming would lie — measured, `đây` stems to `đâi` and `máy` to `mái`.
  /// TWO vectors concatenated since widen_note_search_vector: the text as
  /// written, plus the same text with joining punctuation turned into spaces,
  /// so `apps/web/src` is findable both whole and as its parts. See that
  /// migration for the numbers.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// A pure container in the same tree (Obsidian-style folder): no document
  /// of its own, excluded from search/flat/grouped views, expand-on-click.
  isFolder Boolean @default(false) @map("is_folder")

  isPinned   Boolean   @default(false) @map("is_pinned")
  archivedAt DateTime? @map("archived_at")

  parentId String? @map("parent_id")
  parent   Note?   @relation("NoteTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Note[]  @relation("NoteTree")
  position Int     @default(0)

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  outgoingLinks NoteLink[]     @relation("NoteLinkSource")
  incomingLinks NoteLink[]     @relation("NoteLinkTarget")
  labels        NoteOnLabel[]
  shares        NoteShare[]
  documents     NoteDocument[]

  @@index([ownerId, parentId, position], map: "idx_notes_owner_id_parent_id_position")
  @@index([ownerId, updatedAt(sort: Desc)], map: "idx_notes_owner_id_updated_at")
  // Every list read asks for `_count: { children }`, which Prisma resolves as a
  // predicate on the FK alone — `owner_id` leading the index above cannot serve it.
  @@index([parentId], map: "idx_notes_parent_id")
  // The trash view: `archivedAt: { not: null }` ordered by `archivedAt desc, id`.
  @@index([ownerId, archivedAt(sort: Desc), id], map: "idx_notes_owner_archived")
  // One tree level. The order leads with `isPinned`, so the position index above
  // supplies rows but not the ordering.
  @@index([ownerId, parentId, isPinned(sort: Desc), position], map: "idx_notes_owner_parent_pinned")
  // The flat view's default `updated` sort. `created`/`title` are deliberately
  // left unindexed — three more indexes on the app's hottest write table is a
  // worse trade than sorting a page in memory.
  @@index([ownerId, isFolder, isPinned(sort: Desc), updatedAt(sort: Desc)], map: "idx_notes_owner_flat_updated")
  // `groupBy(['status'])` for the grouped view's section headers.
  @@index([ownerId, isFolder, status], map: "idx_notes_owner_status")
  @@map("notes")
}

model NoteLink {
  createdAt DateTime @default(now()) @map("created_at")

  sourceId String @map("source_id")
  source   Note   @relation("NoteLinkSource", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId String @map("target_id")
  target   Note   @relation("NoteLinkTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
  @@index([targetId], map: "idx_note_links_target_id")
  @@map("note_links")
}

/// A file attached to one note — PDFs today, nothing else accepted.
///
/// Deliberately WITHOUT a `url` column. These objects live in the PRIVATE
/// bucket and are reachable only through `/api/notes/documents/[id]`, which
/// checks the session before it streams a byte. A column named `url` is an
/// invitation for some future component to render one, and the whole point of
/// the private lane is that no such address exists.
model NoteDocument {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// Defaults to the uploaded file's name; a display label, not an identifier.
  title    String
  fileKey  String @unique @map("file_key")
  mimeType String @map("mime_type")
  size     Int

  /// "ATTACHMENT" — a file the author attached; listed in the Files panel.
  /// "INLINE"     — an image the note's own body references; deliberately NOT
  ///                listed, or every pasted screenshot would show up as an
  ///                attachment.
  ///
  /// A String rather than this schema's first enum, matching `NoteShare.role`.
  /// Readers narrow it fail-closed: only an exact "INLINE" is treated as
  /// inline, so a value written by a migration this code has not seen still
  /// behaves like a plain attachment.
  kind String @default("ATTACHMENT")

  noteId String @map("note_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  /// Denormalised from the note so the serving route can answer "is this
  /// yours" with one indexed lookup instead of a join. Safe to duplicate: a
  /// note never changes owner.
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// The panel reads one note's ATTACHMENT rows, newest first, and the editor
  /// resolves INLINE ones by id. `kind` sits in the middle so the panel's read
  /// never pays a filter pass over the inline images, which outnumber the
  /// attachments once pasted screenshots live here too.
  @@index([noteId, kind, createdAt(sort: Desc)], map: "idx_note_documents_note_kind_created")
  @@map("note_documents")
}

model NoteLabel {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name  String
  color String?

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  notes NoteOnLabel[]

  @@unique([ownerId, name])
  @@map("note_labels")
}

model NoteOnLabel {
  createdAt DateTime @default(now()) @map("created_at")

  noteId String @map("note_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  labelId String    @map("label_id")
  label   NoteLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([noteId, labelId])
  @@index([labelId], map: "idx_note_on_labels_label_id")
  @@map("note_on_labels")
}

/// A grant of access to one note, or — when that note is a folder — to its
/// whole subtree.
///
/// Inheritance is resolved by climbing the tree at read time
/// (`resolveNoteAccess`), NEVER materialised into a row per descendant. That
/// is what makes moving a note into or out of a shared folder correct with
/// nothing to synchronise, and what leaves a delete no orphaned grant to
/// clean up — the cascade below takes them.
model NoteShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  noteId String @map("note_id")
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  /// The grant is bound to the ADDRESS, not to a `User` row: it is issued
  /// before the recipient has ever signed in, and may be issued to someone who
  /// never does. Always written through `normalizeEmail()`, which is also what
  /// the lookup compares against — see `shared/lib/auth/normalize-email.ts`.
  email String

  /// Claimed on the recipient's first visit to the shared surface. Null means
  /// the invitation is still pending, which is what the owner's dialog shows.
  recipientId String? @map("recipient_id")
  recipient   User?   @relation("NoteShareRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  /// "VIEWER" | "EDITOR". A String, matching `User.role`, rather than
  /// introducing this schema's first enum. Readers narrow it fail-closed: only
  /// an exact "EDITOR" grants write, so a value written by a future migration
  /// this code has not seen reads as VIEWER.
  role String @default("VIEWER")

  invitedById String @map("invited_by_id")
  invitedBy   User   @relation("NoteShareInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([noteId, email])
  @@index([email], map: "idx_note_shares_email")
  @@map("note_shares")
}

/// Everything the notes workspace remembers ABOUT an author rather than about
/// their notes: editor density, autosave delay, what a rename should do to
/// inbound link labels.
///
/// One JSON column rather than a column per setting, and that is a deliberate
/// trade. The set will keep growing, and a column apiece means a migration
/// apiece against a production database; a blob means one migration ever. What
/// it gives up is querying BY a setting, which nothing does or will — these are
/// read as a whole, once per page load, for exactly one owner.
///
/// The shape is not enforced here, so it is enforced at the boundary instead:
/// `entities/workspace-settings/model/settings-schema.ts` parses this with zod
/// and merges the result over defaults. A row written by an older version of
/// the app, or a field this version has never heard of, therefore reads as the
/// default rather than breaking the workspace.
model WorkspaceSettings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerId String @unique @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Validated and defaulted on read; never trusted as written.
  preferences Json @default("{}")

  @@map("workspace_settings")
}

model SleepLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The spine, and the reason phase 3 is a join rather than a migration.
  /// The date of WAKING, not of going to bed — a sleep from 23:40 on the 21st
  /// to 07:10 on the 22nd is the 22nd's. `@db.Date`, never a timestamp:
  /// grouping timestamps by day at query time drifts with timezone and puts
  /// midnight-crossing rows on the wrong day. Set by `toLocalDate` in
  /// `shared/lib/health/local-date.ts`, which is the only place the rule lives.
  localDate DateTime @db.Date @map("local_date")

  bedAt  DateTime @map("bed_at")
  wakeAt DateTime @map("wake_at")

  /// Out of bed. Time in bed ends here, not at `wakeAt`, so efficiency stops
  /// counting the lie-in as sleep. Optional: rows written before it existed
  /// fall back to `wakeAt` in `sleep-stats.ts`.
  riseAt DateTime? @map("rise_at")

  /// Minutes to fall asleep, and total minutes awake during the night. Both
  /// optional: without either, sleep efficiency is WITHHELD rather than shown
  /// as 100% (see `sleep-stats.ts`). Every other statistic still computes.
  latencyMin    Int? @map("latency_min")
  awakeningsMin Int? @map("awakenings_min")

  /// How many times you woke, beside the minutes already stored. The two
  /// answer different questions: four brief wakings and one long one can share
  /// a minute total and are not the same night.
  awakeningsCount Int? @map("awakenings_count")

  /// 1..5. Optional — never blocks a save.
  quality Int?

  /// 1..5, on waking. The OUTCOME variable — quality rates the night, this
  /// rates the morning it produced, and it is what the insight phase contrasts.
  restedness Int?

  /// none | lt30 | 30to60 | gt60, validated in `sleep-log-schema.ts`. An id,
  /// not a midpoint: an unrecorded nap corrupts duration and debt, and `gt60`
  /// has no upper bound to take a midpoint of.
  napBucket String? @map("nap_bucket")

  note String? @db.Text

  /// When the entry was WRITTEN, distinct from `updatedAt`, which every later
  /// correction moves. A night reconstructed three days late is recall, not
  /// same-morning data, and the insight phase has to be able to tell.
  loggedAt DateTime? @map("logged_at")

  /// Needed by social jetlag and MSFsc (phase 1b), which are defined against
  /// days you were free to sleep as long as you liked. A stored column rather
  /// than derived from the weekday, because holidays and night shifts break
  /// that rule; defaulted from the weekday on create, and editable.
  isFreeDay Boolean @default(false) @map("is_free_day")

  /// caffeine_late | alcohol | screen_late | late_meal | workout_late | ill
  /// Validated by Zod at the action layer, not a database enum: this list will
  /// change, and a migration per new factor is not worth it.
  factors String[]

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// One record per day. Both the correct constraint and what makes the write
  /// an `upsert` — logging roughly on waking and correcting it that evening is
  /// the normal flow, not an edge case.
  @@unique([ownerId, localDate], map: "uniq_sleep_logs_owner_date")
  @@map("sleep_logs")
}

model Exercise {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name String

  /// What makes "sets per muscle per week" computable at all. One primary,
  /// any number of secondary.
  primaryMuscle    String   @map("primary_muscle")
  secondaryMuscles String[] @map("secondary_muscles")

  /// barbell | dumbbell | machine | cable | bodyweight | kettlebell | band
  equipment String

  /// weight_reps | bodyweight_reps | weighted_bodyweight | time
  /// Without this a plank and a pull-up break the set model: one has no reps,
  /// the other no weight. Volume and e1RM read this to decide which formula
  /// even applies.
  metric String @default("weight_reps")

  /// Hidden, never deleted -- see WorkoutExercise's Restrict below.
  isArchived Boolean @default(false) @map("is_archived")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  routineItems     RoutineExercise[]
  workoutExercises WorkoutExercise[]

  /// THE constraint per-exercise statistics depend on. Without it
  /// "Bench Press" and "Bench press " become two progression curves.
  @@unique([ownerId, name], map: "uniq_exercises_owner_name")
  @@index([ownerId, primaryMuscle], map: "idx_exercises_owner_muscle")
  @@map("exercises")
}

model Routine {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  name       String
  notes      String? @db.Text
  position   Int     @default(0)
  isArchived Boolean @default(false) @map("is_archived")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items    RoutineExercise[]
  sessions WorkoutSession[]

  @@index([ownerId, isArchived, position], map: "idx_routines_owner_position")
  @@map("routines")
}

model RoutineExercise {
  id       String @id @default(cuid())
  position Int

  /// The PLAN, not the result. The logging screen reads these to prefill and
  /// to render "3x8 @ RPE 8" beside the input.
  targetSets     Int?     @map("target_sets")
  targetRepsLow  Int?     @map("target_reps_low")
  targetRepsHigh Int?     @map("target_reps_high")
  targetRpe      Decimal? @db.Decimal(3, 1) @map("target_rpe")
  restSec        Int?     @map("rest_sec")

  routineId  String   @map("routine_id")
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String   @map("exercise_id")
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([routineId, position], map: "idx_routine_exercises_routine_position")
  @@map("routine_exercises")
}

model WorkoutSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Same convention as SleepLog, and the column phase 3 joins on. The day the
  /// session STARTED (a sleep uses the day it ENDED -- see local-date.ts).
  localDate DateTime  @db.Date @map("local_date")
  startedAt DateTime  @map("started_at")
  /// null means in progress. No separate status column is needed.
  endedAt   DateTime? @map("ended_at")

  /// A SNAPSHOT of the routine name, not merely the FK. Deleting the "Push Day"
  /// routine must not blank the heading of sixty past sessions.
  title String

  notes String? @db.Text
  /// Foster session-RPE, 0..10. Times duration gives training load.
  sessionRpe Decimal? @db.Decimal(3, 1) @map("session_rpe")

  routineId String?  @map("routine_id")
  routine   Routine? @relation(fields: [routineId], references: [id], onDelete: SetNull)

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  exercises WorkoutExercise[]

  @@index([ownerId, localDate(sort: Desc)], map: "idx_workout_sessions_owner_date")
  /// The question the app opens with: is a session still running? Normally
  /// matches zero or one row.
  @@index([ownerId, endedAt], map: "idx_workout_sessions_owner_open")
  @@map("workout_sessions")
}

model WorkoutExercise {
  id       String  @id @default(cuid())
  position Int
  notes    String? @db.Text

  sessionId String         @map("session_id")
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Restrict, NOT Cascade: deleting a catalog entry by mistake must not delete
  /// the history of training it. Hiding is `isArchived`.
  exerciseId String   @map("exercise_id")
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets WorkoutSet[]

  @@index([sessionId, position], map: "idx_workout_exercises_session_position")
  /// The index every per-exercise statistic goes through.
  @@index([exerciseId], map: "idx_workout_exercises_exercise")
  @@map("workout_exercises")
}

model WorkoutSet {
  id       String @id @default(cuid())
  position Int

  reps Int?
  /// Canonical kg. Showing lb is a display setting, never a second unit in this
  /// column -- two units in one column is how a volume total starts lying.
  weightKg    Decimal? @db.Decimal(6, 2) @map("weight_kg")
  rpe         Decimal? @db.Decimal(3, 1)
  durationSec Int?     @map("duration_sec")

  /// EXCLUDES the set from volume, from PR detection, and from the per-muscle
  /// set count. Without the flag every hypertrophy number inflates with warm-ups.
  isWarmup Boolean @default(false) @map("is_warmup")

  /// When the set was marked done, which is what makes real rest intervals
  /// recoverable after the fact.
  completedAt DateTime? @map("completed_at")

  workoutExerciseId String          @map("workout_exercise_id")
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId, position], map: "idx_workout_sets_exercise_position")
  @@map("workout_sets")
}

// ===============================
// DAY JOURNAL
// ===============================

/// A day, as the owner writes it up.
///
/// Separate from `SleepLog` and not a set of columns on it, for two reasons
/// that both matter. A reflection must be writable on a day with no sleep
/// logged at all — a journal that requires a sleep row is not a journal. And
/// `SleepLog.localDate` is the day a night ENDED, so an entry keyed to it
/// would file "how Friday went" under Saturday for anyone who slept past
/// midnight. The two tables meet at `localDate` with exactly one day of
/// deliberate offset between their meanings.
model DayEntry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The CALENDAR day. `@db.Date`, never a timestamp: grouping timestamps by
  /// day at query time drifts with timezone.
  localDate DateTime @db.Date @map("local_date")

  /// 1..5. The five faces the sleep quality scale used to draw — they move
  /// here, and sleep quality becomes dots, so one picture means one thing.
  mood Int?

  reflection String? @db.Text

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  photos DayPhoto[]

  /// One entry per day, which is what makes the write an upsert rather than a
  /// select-then-insert with a race in the middle.
  @@unique([ownerId, localDate], map: "uniq_day_entries_owner_date")
  @@map("day_entries")
}

/// One photo attached to a day, with its own caption.
///
/// There is no `url` column, and that is the security decision of this
/// feature rather than an omission. These objects live in
/// `SUPABASE_S3_PRIVATE_BUCKET`, where a public URL resolves to nothing; the
/// only address a photo has is `/api/health/photos/[id]`, which checks the
/// session first. A `url` column would be a value some future component
/// renders as a broken image — or, worse, a reason for someone to move these
/// into the public bucket so the column works.
model DayPhoto {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fileKey  String @unique @map("file_key")
  mimeType String @map("mime_type")
  size     Int

  caption String? @db.Text

  /// Display order within the day. Not `createdAt`, so a photo can be reordered
  /// later without rewriting a timestamp that means something else.
  position Int @default(0)

  dayEntryId String   @map("day_entry_id")
  dayEntry   DayEntry @relation(fields: [dayEntryId], references: [id], onDelete: Cascade)

  /// Denormalised from the entry so the serving route answers "is this yours"
  /// with one indexed lookup instead of a join. Safe to duplicate: an entry
  /// never changes owner. Same reasoning as `NoteDocument.ownerId`.
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([dayEntryId, position])
  @@map("day_photos")
}
