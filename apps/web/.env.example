# Copy to apps/web/.env. These values run the app against the local compose stack
# (docs/setup.md). Blank values are optional locally; see docs/environment.md.

# --- APP CONFIGURATION ---
# development, production, or test
NODE_ENV=development
# Public environment variable for client-side logic
NEXT_PUBLIC_ENV=development

# --- DATABASE (Prisma / PostgreSQL 17) ---
# Local: `docker compose up -d`. Supabase: use the direct connection (port 5432) for migrations.
DATABASE_URL=postgresql://admin:secret@localhost:5432/byte_of_me
# Required by env validation; migrations read DATABASE_URL.
DIRECT_URL=postgresql://admin:secret@localhost:5432/byte_of_me

# --- ANALYTICS & PUBLIC INFO ---
# Google Analytics Measurement ID (starts with G-)
NEXT_PUBLIC_GA_ID=
# The email displayed publicly on the site
NEXT_PUBLIC_AUTHOR_EMAIL=you@example.com

# --- AUTHENTICATION (Auth.js / NextAuth) ---
# Base URL of the app (must match your deployment URL in production)
AUTH_URL=http://localhost:3000
# High-entropy random string for encrypting cookies (generate via 'openssl rand -base64 32')
AUTH_SECRET=

# --- EMAIL SERVICE (SMTP / Nodemailer) ---
# Local: Mailpit from docker compose; magic links appear at http://localhost:8025.
# Production: your SMTP provider, e.g. smtp.gmail.com (587) or smtp.resend.com.
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
# Mailpit takes no credentials.
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Byte of Me <dev@localhost>"

# --- STORAGE (Supabase S3 / Image Uploads) ---
# Blank locally: the app still runs, media uploads fail.
# S3 Region (e.g., ap-northeast-1 for Tokyo)
SUPABASE_S3_STORAGE_REGION=ap-northeast-1
# S3 API endpoint (Supabase > Storage > S3 connection)
SUPABASE_S3_STORAGE_ENDPOINT=
# Public URL used to serve/display the images in the browser
SUPABASE_S3_STORAGE_PUBLIC_ENDPOINT=
# S3 access key and secret key
SUPABASE_S3_STORAGE_ACCESS_KEY=
SUPABASE_S3_STORAGE_SECRET_KEY=
# Bucket name in Supabase Storage
SUPABASE_S3_STORAGE_BUCKET=byte-of-me

# --- BUSINESS LOGIC / ADMIN ---
# Must equal EMAIL in packages/db/.env (the seeded admin). Also the public contact address.
EMAIL=you@example.com
# Optional. Unset, the dashboard identity is EMAIL.
# OWNER_EMAIL=you@example.com
# Seeded author id from packages/db/prisma/seed.ts. Keep it: public pages render empty without it.
AUTHOR_ID=cseedauthor0000000000001

# --- OAUTH (optional locally; email sign-in works without them) ---
# https://authjs.dev/guides/configuring-github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Open-source section on the homepage and /projects, read from GitHub's GraphQL search.
# Without GITHUB_TOKEN the section is hidden.
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
GITHUB_LOGIN=lthphuw
