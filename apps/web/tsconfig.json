{
  "extends": "../../packages/config/typescript/nextjs.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@byte-of-me/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "src/shared/types",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.js"
  ],
  "exclude": ["node_modules"]
}
