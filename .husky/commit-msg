#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# AGENTS.md §13 forbids `Co-authored-by` and attribution trailers, but agent harnesses
# inject them anyway. Strip them here: a hook does not forget.
msg="$1"
tmp="$msg.stripped"

# Both patterns are anchored: an unanchored one ate body lines that merely quoted a trailer.
# The leading `[^[:alnum:][:space:]]*` skips a decoration such as the robot emoji.
grep -viE \
  -e '^[[:space:]]*co-authored-by:' \
  -e '^[[:space:]]*[^[:alnum:][:space:]]*[[:space:]]*(generated|made|created) (with|by)[[:space:]]' \
  "$msg" > "$tmp" || true

# Removing a trailer block leaves trailing blank lines behind; drop them.
awk '{ line[NR] = $0 }
     END { for (i = NR; i > 0; i--) if (line[i] ~ /[^[:space:]]/) { last = i; break }
           for (i = 1; i <= last; i++) print line[i] }' "$tmp" > "$msg"
rm -f "$tmp"

npx commitlint --edit $1
