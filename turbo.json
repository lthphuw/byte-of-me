{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "packages/config/typescript/*.json"
  ],
  "cacheMaxSize": "5GB",
  "cacheMaxAge": "14d",
  "tasks": {
    "transit": {
      "description": "No package has this script. It only carries each package's file hash to its dependants, so their tasks re-run when a dependency changes while still running in parallel.",
      "dependsOn": [
        "^transit"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "^transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DIRECT_URL",
        "AUTH_URL",
        "AUTH_SECRET",
        "EMAIL_SERVER_HOST",
        "EMAIL_SERVER_PORT",
        "EMAIL_SERVER_USER",
        "EMAIL_SERVER_PASSWORD",
        "EMAIL_FROM",
        "SUPABASE_S3_STORAGE_REGION",
        "SUPABASE_S3_STORAGE_ENDPOINT",
        "SUPABASE_S3_STORAGE_PUBLIC_ENDPOINT",
        "SUPABASE_S3_STORAGE_ACCESS_KEY",
        "SUPABASE_S3_STORAGE_SECRET_KEY",
        "SUPABASE_S3_STORAGE_BUCKET",
        "EMAIL",
        "AUTHOR_ID",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "NEXT_PUBLIC_ENV",
        "NEXT_PUBLIC_GA_ID",
        "NEXT_PUBLIC_AUTHOR_EMAIL",
        "OWNER_EMAIL",
        "GITHUB_TOKEN",
        "GITHUB_LOGIN",
        "PORT",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "db:migrate:dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": [
        "^generate"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^transit"
      ]
    },
    "test": {
      "dependsOn": [
        "^transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config/test/**"
      ]
    },
    "lint:fix": {
      "cache": false
    }
  }
}
